# Application
APP_NAME=SecureWatch
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://securewatch:securewatch@localhost:5432/securewatch

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# JWT (RS256) — generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_YOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENROLLMENT_TOKEN_EXPIRE_HOURS=24

# Security
SECRET_KEY=REPLACE_WITH_RANDOM_64_BYTE_HEX_STRING
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100

# Super Admin (used by seed script)
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@securewatch.local
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# MFA encryption key (Fernet, generate: from cryptography.fernet import Fernet; Fernet.generate_key())
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
