# =============================================================================
# SecureWatch – Git Ignore Rules
# =============================================================================

# --- Environment & Sensitive Credentials (CRITICAL - NEVER COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
celerybeat-schedule*
*.sqlite3
*.db

# Unit test / coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# --- Frontend (Node / Vite / React) ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Terraform / AWS Cloud ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Docker & Local Data ---
data/
*.log
logs/
docker-volumes/
postgres-data/
opensearch-data/
redis-data/

# --- OS / IDE Metadata ---
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Endpoint Agent Local Keystore ---
/etc/securewatch/
endpoint-agent/config.json
endpoint-agent/venv/
